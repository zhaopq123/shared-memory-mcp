# ══════════════ shared-memory-mcp 配置示例 ══════════════
#
# 用法：复制为 .env 并按需修改，或在 systemd/runit/tmux 启动脚本里
# 作为环境变量传入。所有变量都有合理默认值，**只设你需要的**。

# ── 服务监听 ──
# 0.0.0.0 允许局域网/其他机器连（跨工具共享的前提）
# 127.0.0.1 只允许本机
HOST=0.0.0.0
PORT=8200

# ── 记忆库位置 ──
# 一条记忆 = 一个 Markdown 文件；整个目录是一个 git 仓库
SHARED_MEMORY_ROOT=/opt/shared-memory-mcp/vault

# ── 鉴权 ──
# 空 = 不校验（仅适合本机/纯内网）
# ⚠️ 暴露到公网**必须**设置，否则任何人扫到端口都能读写你全部记忆
# 生成：head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
SHARED_MEMORY_TOKEN=

# ── git 自动提交 ──
# 写入静默多少秒后自动 commit（避免一个 agent 连写 5 条产生 5 个提交）
# 设 0 = 每次写都提交（写入量大时 git 会成为瓶颈）
SHARED_MEMORY_COMMIT_DEBOUNCE=8
# 设 0 可完全关闭 git 版本化（不推荐：会失去可回滚与异地备份能力）
SHARED_MEMORY_AUTOCOMMIT=1

# ── 日志 ──
LOG_LEVEL=INFO
