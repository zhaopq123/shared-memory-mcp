# ══════════════ shared-memory-mcp 配置示例 ══════════════
#
# 用法：复制为 .env 并按需修改，或在 systemd/runit/tmux 启动脚本里
# 作为环境变量传入。**所有变量都有默认值，只设你要改的那几个**
# （配置本体在 vault 的 _config/ 里，面板可改、随 git 走；这里只管启动参数）。
#
# 启动时会对这些变量做校验（F-1）：值畸形 → **拒绝启动**并把变量名打进日志；
# 相对路径、拼错的变量名 → 照常启动但给提醒。
# 校验清单与语义只有一份：``src/shared_memory/config.py`` 的
# ``validate_startup_env`` / ``KNOWN_ENV_VARS`` —— 本文件与它逐条对齐，
# **这里写了而代码不读的开关等于编造能力**。

# ── 服务监听 ──
# 0.0.0.0 允许局域网/其他机器连（跨工具共享的前提）
# 127.0.0.1 只允许本机
HOST=0.0.0.0
PORT=8200

# ── 记忆库位置（两个变量、两个用途，别混）──
# SHARED_MEMORY_HOME：**多库中枢**根目录（tenants.json、state/、各库都在这下面）
SHARED_MEMORY_HOME=/data/shm/home
# SHARED_MEMORY_ROOT：单库服务模式的默认 vault 位置（一条记忆 = 一个 md 文件）
# ⚠️ 指到独立目录，别放进代码仓库里，否则记忆的 commit 会污染代码仓库
SHARED_MEMORY_ROOT=/opt/shared-memory-mcp/vault

# ── 凭据（MCP / agent 用）──
# 推荐：只写路径，密钥在文件里（600 权限）。环境变量会出现在 `ps e`、
# 容器 inspect 与崩溃转储里。
SHARED_MEMORY_TOKEN_FILE=/etc/shared-memory/tokens
# 文件每行一把，四种写法（第四种才写得出"只读"）：
#   <token>
#   <user>:<token>
#   <user>:<label>:<token>
#   <user>:<label>:<scope>:<token>        scope = read | readwrite
#
# 直填明文（不推荐，仅临时排错）：逗号分隔多把
# SHARED_MEMORY_TOKEN=
#
# 无凭据时是否允许启动：默认**拒绝**。1 = 接受无鉴权运行，
# 此时同一网段任何人都能读写你的全部记忆。
SHARED_MEMORY_ALLOW_INSECURE=0

# ⚠️ **主密钥与面板 PIN 不走环境变量** —— 没有 SHARED_MEMORY_MASTER_KEY /
#    _PIN 这种开关。两者只在面板「管理 → 接入」里设置，盘上只存 sha256，
#    明文只出现一次（设计见 auth.py 的 S-6 段）。
#    把它们做成环境变量的话，密钥就长期躺在 `ps e` 与容器配置里 ——
#    这正是 v2 要把 token 体系换掉的原因之一。

# ── git 自动提交 ──
# 写入静默多少秒后自动 commit（避免一个 agent 连写 5 条产生 5 个提交）
# 设 0 = 每次写都提交（写入量大时 git 会成为瓶颈）
SHARED_MEMORY_COMMIT_DEBOUNCE=8
# 设 0 可完全关闭 git 版本化（不推荐：会失去可回滚与异地备份能力）
SHARED_MEMORY_AUTOCOMMIT=1

# ── 停机（F-5）──
# 收到 SIGTERM 后，排空各库写队列的预算秒数。排空做的是
# 「补一次防抖提交 + 停写者循环」，超时就放弃等待强制退出。
SHARED_MEMORY_SHUTDOWN_DRAIN_TIMEOUT=10

# ── 日志 ──
# DEBUG / INFO / WARNING / ERROR / CRITICAL（其他值会被拒绝启动）
# 每行带 rid=<请求 ID>，同一次请求的多行日志可以串起来
LOG_LEVEL=INFO
